    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
